<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Discovery: Android drops multicast packets unless an app holds a multicast lock. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Knowing whether the phone is on Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Sharing on with the app closed, and transfers finishing with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name=".SharingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".StopReceiver"
            android:exported="false" />
    </application>
</manifest>
