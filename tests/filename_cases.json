{
  "file_names": [
    { "input": "report.pdf", "expected": "report.pdf" },
    { "input": "日本語.txt", "expected": "日本語.txt" },
    { "input": "name.with.many.dots.tar.gz", "expected": "name.with.many.dots.tar.gz" },
    { "input": ".bashrc", "expected": ".bashrc" },
    { "input": "../../etc/passwd", "expected": ".._.._etc_passwd" },
    { "input": "a\\b/c", "expected": "a_b_c" },
    { "input": "a:b*c?.txt", "expected": "a_b_c_.txt" },
    { "input": "q\"<>|.txt", "expected": "q____.txt" },
    { "input": "..", "expected": "unnamed" },
    { "input": ".", "expected": "unnamed" },
    { "input": "", "expected": "unnamed" },
    { "input": "   ", "expected": "unnamed" },
    { "input": "...", "expected": "unnamed" },
    { "input": "  lead.txt", "expected": "lead.txt" },
    { "input": "trailing. . ", "expected": "trailing" },
    { "input": "file\u0000.txt", "expected": "file.txt" },
    { "input": "a\tb\nc\r", "expected": "abc" },
    { "input": "del\u007fete\u0085.txt", "expected": "delete.txt" },
    { "input": "photo\u202Egpj.exe", "expected": "photogpj.exe" },
    { "input": "zero\u200bwidth\ufeff.txt", "expected": "zerowidth.txt" },
    { "input": "iso\u2066late\u2069.txt", "expected": "isolate.txt" },
    { "input": "CON", "expected": "_CON" },
    { "input": "con.txt", "expected": "_con.txt" },
    { "input": "con.", "expected": "_con" },
    { "input": "Nul", "expected": "_Nul" },
    { "input": "nul ", "expected": "_nul" },
    { "input": "COM1.log", "expected": "_COM1.log" },
    { "input": "LPT9", "expected": "_LPT9" },
    { "input": "AUX .txt", "expected": "_AUX .txt" },
    { "input": "console.txt", "expected": "console.txt" },
    { "input": "COM10", "expected": "COM10" },
    { "input": "CON:", "expected": "CON_" }
  ],
  "relative_paths": [
    { "input": "docs/a.txt", "expected": "docs/a.txt" },
    { "input": "docs\\sub\\a.txt", "expected": "docs/sub/a.txt" },
    { "input": "../../x", "expected": "x" },
    { "input": "a/../b", "expected": "a/b" },
    { "input": "a/./b//c", "expected": "a/b/c" },
    { "input": "/abs/path", "expected": "abs/path" },
    { "input": "C:\\Windows\\system.ini", "expected": "C_/Windows/system.ini" },
    { "input": "a/CON/b.txt", "expected": "a/_CON/b.txt" },
    { "input": "a/b:c/d", "expected": "a/b_c/d" },
    { "input": "folder/photo\u202Egpj.exe", "expected": "folder/photogpj.exe" },
    { "input": "", "expected": null },
    { "input": ".", "expected": null },
    { "input": "../..", "expected": null },
    { "input": "/", "expected": null }
  ]
}
